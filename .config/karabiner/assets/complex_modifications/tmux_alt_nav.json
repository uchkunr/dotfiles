{
  "title": "TMUX Alt Navigation",
  "rules": [
    {
      "description": "Map Windows Alt to Option for TMUX Alt + , / Alt + .",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_alt"
          },
          "to": [
            {
              "key_code": "left_option"
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "right_alt"
          },
          "to": [
            {
              "key_code": "right_option"
            }
          ]
        }
      ]
    }
  ]
}

